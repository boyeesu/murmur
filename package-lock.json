{
  "name": "murmur-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "murmur-workspace",
      "license": "MIT",
      "workspaces": [
        "packages/murmur",
        "apps/dashboard"
      ],
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "apps/dashboard": {
      "name": "murmur-dashboard",
      "version": "0.0.0"
    },
    "node_modules/murmur-dashboard": {
      "resolved": "apps/dashboard",
      "link": true
    },
    "node_modules/murmur-local": {
      "resolved": "packages/murmur",
      "link": true
    },
    "packages/murmur": {
      "name": "murmur-local",
      "version": "0.2.0",
      "license": "MIT",
      "bin": {
        "murmur": "dist/cli/index.js"
      },
      "engines": {
        "node": ">=24.0.0"
      }
    }
  }
}
